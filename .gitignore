# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/

# Training artifacts (large, regenerable)
runs/
checkpoints/
renders/

# Project memory / session state (not for sharing)
memory-bank/
.claude/

# Source papers (third-party, copyrighted, large) — md summaries are tracked
papers/*.pdf

# Images / preview assets not needed to run the sim
*.png

# macOS
.DS_Store

# MuJoCo runtime log (regenerable)
MUJOCO_LOG.TXT

# Blog post is a self-contained deliverable: keep its own figures and renders
# even though *.png and renders/ are ignored globally for research artifacts.
!blog/renders/
!blog/figures/*.png
!blog/renders/*.gif

# Playwright MCP screenshot scratch
.playwright-mcp/
