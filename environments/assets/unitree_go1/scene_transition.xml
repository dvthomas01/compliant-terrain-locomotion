<mujoco model="go1 transition scene">
  <include file="go1.xml"/>
  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="soft" rgba="0.85 0.45 0.2 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <!-- Soft zone: 4 spring tiles at x in [1.8, 3.0] the robot crosses mid-episode (rigid->soft->rigid).
         Each tile = box on a vertical slide-joint spring (a MOVING body — collides with the foot, unlike
         static box patches). Top at z=0.05 at rest; sinks under load. Stiffness set per episode by the env
         (curriculum: firm -> soft). tile-floor contact excluded so tiles slide freely. Full width in y. -->
    <body name="tile0" pos="1.95 0 0.03"><joint name="tile0_j" type="slide" axis="0 0 1" range="-0.06 0.002" stiffness="20000" damping="60"/><geom name="tile0_g" type="box" size="0.15 0.6 0.02" material="soft" priority="3" condim="6" friction="0.8 0.02 0.01"/></body>
    <body name="tile1" pos="2.25 0 0.03"><joint name="tile1_j" type="slide" axis="0 0 1" range="-0.06 0.002" stiffness="20000" damping="60"/><geom name="tile1_g" type="box" size="0.15 0.6 0.02" material="soft" priority="3" condim="6" friction="0.8 0.02 0.01"/></body>
    <body name="tile2" pos="2.55 0 0.03"><joint name="tile2_j" type="slide" axis="0 0 1" range="-0.06 0.002" stiffness="20000" damping="60"/><geom name="tile2_g" type="box" size="0.15 0.6 0.02" material="soft" priority="3" condim="6" friction="0.8 0.02 0.01"/></body>
    <body name="tile3" pos="2.85 0 0.03"><joint name="tile3_j" type="slide" axis="0 0 1" range="-0.06 0.002" stiffness="20000" damping="60"/><geom name="tile3_g" type="box" size="0.15 0.6 0.02" material="soft" priority="3" condim="6" friction="0.8 0.02 0.01"/></body>
  </worldbody>

  <contact>
    <exclude body1="tile0" body2="world"/>
    <exclude body1="tile1" body2="world"/>
    <exclude body1="tile2" body2="world"/>
    <exclude body1="tile3" body2="world"/>
  </contact>
</mujoco>
