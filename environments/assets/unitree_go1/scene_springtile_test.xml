<mujoco model="go1 springtile collision test">
  <include file="go1.xml"/>
  <statistic center="0 0 0.1" extent="0.8"/>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05"/>
    <!-- Spring tile: a box on a vertical slide joint (spring). Under foot load it slides
         down (real geometric sinkage) and springs back. A MOVING body, unlike the static
         worldbody box patches that failed to collide with the foot. Top at z=0.05 at rest. -->
    <body name="tile" pos="0 0 0.03">
      <joint name="tile_slide" type="slide" axis="0 0 1" range="-0.06 0.002"
             stiffness="600" damping="40" springref="0"/>
      <geom name="tile_geom" type="box" size="0.6 0.6 0.02" rgba="0.85 0.45 0.2 1"
            priority="3" condim="6" friction="0.8 0.02 0.01"/>
    </body>
  </worldbody>
  <contact>
    <exclude body1="tile" body2="world"/>   <!-- tile may sink below the floor plane freely -->
  </contact>
</mujoco>
